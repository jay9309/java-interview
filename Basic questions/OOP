// ✔ Loose Coupling
// ✔ Multiple Inheritance of Type
//
// Real-world example:
//
// Payment interface common contract define karta hai.

interface PaymentService {

    void pay();
}


// Different classes apna-apna implementation deti hain.

class UPIService implements PaymentService {

    public void pay() {
        System.out.println("Payment using UPI");
    }
}

class CardService implements PaymentService {

    public void pay() {
        System.out.println("Payment using Card");
    }
}


// Same contract:
//
// PaymentService
//       |
//       ├── UPIService
//       |
//       └── CardService
//
// Dono classes ko pay() implement karna compulsory hai,
// lekin pay() ka implementation different ho sakta hai.
















